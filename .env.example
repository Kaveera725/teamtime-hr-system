# ==============================================================================
# Employee Leave & Attendance Management System - Environment Variables
# Reference: Section 11.2 of docs/PROJECT_DOCUMENTATION.md
# ==============================================================================

# Database Container Configuration (docker-compose.dev.yml)
POSTGRES_DB=employee_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_me
POSTGRES_PORT=5432

# Backend Database Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=employee_management;Username=postgres;Password=postgres_dev_password_change_me

# JWT Authentication
Jwt__Key=super_secret_jwt_key_that_is_at_least_32_characters_long_for_security
Jwt__Issuer=EmployeeManagementAPI
Jwt__Audience=EmployeeManagementWeb
Jwt__ExpiryMinutes=60

# CORS Configuration (comma-separated origins for web frontend)
Cors__AllowedOrigins=http://localhost:5173,http://localhost:3000

# Seed Admin User (used on initial start only)
Seed__AdminEmail=admin@company.com
Seed__AdminPassword=Admin@123456ChangeMe!

# Attendance Business Rule Configuration (Threshold for marking LATE)
Attendance__LateAfter=09:00

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Development
